#!/usr/bin/env bash
# local-llm-mcp-run - start one of the local LLM's MCP servers inside a
# bubblewrap sandbox. llama-server launches this via ~/.config/local-llm/mcp.json.
#
# The sandbox sees only: /usr (read-only), the few /etc files needed for DNS and
# TLS, its own code at /app (read-only), a private empty /tmp, and - for the
# deepseek server only - the DeepSeek key directory (read-only).
# It does NOT see your home directory, other secrets, SSH keys, browser data,
# D-Bus or other processes (own PID/IPC/UTS/user namespaces, clean environment,
# new session, killed when llama-server exits). Network is shared for the web
# tools (local/private addresses are refused in code, see safe_http); the
# use_obsidian server gets no network at all and sees only the vault.
set -euo pipefail

APP_DIR="${HOME}/.local/share/local-llm"
SECRETS_DIR="${HOME}/.config/local-llm/secrets"

server="${1:-}"
extra=()
net=(--share-net)
case "$server" in
    web_search)
        ;;
    deepseek)
        mkdir -p "${SECRETS_DIR}/deepseek"
        extra+=(--ro-bind "${SECRETS_DIR}/deepseek" /run/secrets/deepseek)
        ;;
    use_obsidian)
        # Only the vault is visible: read-only at /vault-ro (read tools) and
        # writable at /vault (write_note), plus the backup folder. No network.
        vault="${LOCAL_LLM_OBSIDIAN_VAULT:-$(head -n1 "${HOME}/.config/local-llm/obsidian-vault" 2>/dev/null)}"
        vault=$(realpath -e -- "$vault" 2>/dev/null) || { echo "use_obsidian: vault not found" >&2; exit 1; }
        if [ ! -d "$vault/.obsidian" ] || [ "$vault" = "$HOME" ] || [ "$vault" = "/" ]; then
            echo "use_obsidian: $vault is not an Obsidian vault (no .obsidian folder)" >&2
            exit 1
        fi
        backups="${HOME}/.local/share/local-llm-obsidian-backups"
        mkdir -p "$backups" && chmod 700 "$backups"
        extra+=(--ro-bind "$vault" /vault-ro --bind "$vault" /vault --bind "$backups" /backups)
        net=()
        ;;
    *)
        echo "usage: $0 {web_search|deepseek|use_obsidian}" >&2
        exit 2
        ;;
esac

exec /usr/bin/bwrap \
    --unshare-all "${net[@]}" \
    --die-with-parent --new-session \
    --clearenv \
    --setenv PATH /usr/bin \
    --setenv HOME /tmp \
    --setenv LANG C.UTF-8 \
    --setenv PYTHONDONTWRITEBYTECODE 1 \
    --ro-bind /usr /usr \
    --symlink usr/bin /bin \
    --symlink usr/bin /sbin \
    --symlink usr/lib /lib \
    --symlink usr/lib /lib64 \
    --ro-bind-try /etc/resolv.conf /etc/resolv.conf \
    --ro-bind-try /run/systemd/resolve /run/systemd/resolve \
    --ro-bind-try /etc/hosts /etc/hosts \
    --ro-bind-try /etc/host.conf /etc/host.conf \
    --ro-bind-try /etc/gai.conf /etc/gai.conf \
    --ro-bind-try /etc/nsswitch.conf /etc/nsswitch.conf \
    --ro-bind-try /etc/ssl /etc/ssl \
    --ro-bind-try /etc/ca-certificates /etc/ca-certificates \
    --ro-bind-try /etc/localtime /etc/localtime \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --ro-bind "${APP_DIR}" /app \
    "${extra[@]}" \
    --chdir /app \
    /usr/bin/python3 -I -B "/app/mcp/${server}.py"
