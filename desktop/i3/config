#screenshots
bindsym $mod+Shift+z exec --no-startup-id flameshot gui -p ~/Pictures/screenshots

bindsym $mod+Shift+s exec --no-startup-id sh -c 'maim -s -u | xclip -selection clipboard -t image/png'

# screen recording (gpu-screen-recorder, ~/.local/bin/screen-recorder.sh)
# press again to stop and save; pause / quality / audio are in drun "Screen Recorder"
bindsym $mod+Shift+period exec --no-startup-id ~/.local/bin/screen-recorder.sh toggle
bindsym $mod+Shift+slash exec --no-startup-id ~/.local/bin/screen-recorder.sh toggle-area

bar {
        status_command i3status -c $HOME/.config/i3/i3status.conf
}

