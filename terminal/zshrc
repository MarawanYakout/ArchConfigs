# WayDroid + Expo helper (added by claude 2026-07-15)
# expo-open [ip]  -> deep-links the running Metro project into Expo Go on WayDroid, no manual URL typing
expo-open() {
  local ip="${1:-$(ip route get 1.1.1.1 2>/dev/null | awk '{print $7; exit}')}"
  adb -s <waydroid-ip>:5555 shell am start -a android.intent.action.VIEW -d "exp://${ip}:8081"
}

